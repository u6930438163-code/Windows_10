# NIGDY nie umieszczaj prawdziwych tokenów w GitHubie.
# Lokalny plik .env jest ignorowany przez .gitignore, lecz skrypty same go nie wczytują.
# Ustaw te zmienne w środowisku uruchomieniowym PowerShell.
#
# Lokalna baza wiadomości (opcjonalnie):
WINDOWS10_AGENT_DB=
# Zewnętrzny serwer agentów — tylko po potwierdzeniu zgodności API:
AGENT_GATEWAY_URL=
AGENT_GATEWAY_SEND_PATH=
AGENT_GATEWAY_TOKEN=
# Token ochronny lokalnego serwera HTTP (min. 16 znaków):
WINDOWS10_LOCAL_TOKEN=
